    <!-- Settings -->
    <string name="settings_sub">AURA OS · Cinematic Android TV Launcher</string>
    <string name="sec_appearance">Appearance</string>
    <string name="sec_home">Home screen</string>
    <string name="sec_system">System</string>
    <string name="set_wallpaper_help">Pick a fixed wallpaper, or let AURA rotate through the pictures automatically.</string>
    <string name="set_interval">Change wallpaper</string>
    <string name="set_interval_help">How often the wallpaper changes when Automatic change is selected.</string>
    <string name="set_dim">Wallpaper dimming</string>
    <string name="set_dim_help">How dark the cinematic gradient over the wallpaper is. Strong reads best on bright pictures.</string>
    <string name="set_camera">Camera motion</string>
    <string name="set_camera_help">A slow, cinematic pan across the wallpaper. Off by default: it keeps the GPU busy all the time, and on some TVs navigation gets less smooth while it runs.</string>
    <string name="set_accent">Accent colour</string>
    <string name="set_accent_help">The colour of focus frames, buttons and highlights throughout AURA.</string>
    <string name="set_order_help">Choose which apps sit in the app row, and in what order.</string>
    <plurals name="n_apps">
        <item quantity="one">%d app</item>
        <item quantity="other">%d apps</item>
    </plurals>
    <string name="set_style">App cards</string>
    <string name="set_style_help">Dark with logo shows each app\'s colourful logo on a black card. Glass shows it on dark glass. Original banner shows the app\'s own banner with its built-in background.</string>
    <string name="set_size">Card size</string>
    <string name="set_size_help">The size of the cards in the app row and the Recently used row.</string>
    <string name="set_labels">App names</string>
    <string name="set_labels_help">Show only the focused app\'s name, or names under every card.</string>
    <string name="set_recent">Recently used</string>
    <string name="set_recent_help">The row of apps you used last. With usage access it includes apps opened from anywhere; without it, only apps opened from AURA.</string>
    <string name="set_greeting">Greeting under the clock</string>
    <string name="set_greeting_help">Shows Good morning, Good afternoon and so on under the date.</string>
    <string name="set_usage">Usage access</string>
    <string name="set_usage_help">Lets the Recently used row see apps you opened outside AURA. Android stores this history on the TV; AURA never sends anything anywhere.</string>
    <string name="set_home">Default home app</string>
    <string name="set_home_help">Opens the system screen for choosing the home app, where the TV offers one. Some Google TV models do not let you change it without extra steps; see the project\'s installation guide.</string>
    <string name="set_all_apps_help">See and open every installed app.</string>
    <string name="set_system_help">Network, sound, picture, remote and the other system settings.</string>
    <string name="set_about">About AURA OS</string>
    <string name="version">Version %s</string>
    <string name="set_about_help">AURA OS is free and open source under the MIT licence, based on tv-home by Mihir Gupta. Wallpaper photos are from Wikimedia Commons under CC BY-SA; the photographer is shown under each picture in Wallpaper. Icons from Material Icons (Apache 2.0). App logos belong to their owners. No ads, no tracking, no network access.</string>
