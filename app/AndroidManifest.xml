<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.saksen2k1.aura"
    android:versionCode="1101"
    android:versionName="1.1.0-beta.1">

    <!-- Connection status for the Wi-Fi button. No network access is requested. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Recently used": only effective after the user allows usage access in system settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.software.live_tv" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.google.android.tv" />
        <package android:name="com.android.tv" />
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.sony.dtv.tvx" />
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_home"
        android:banner="@drawable/ic_home"
        android:allowBackup="false"
        android:theme="@style/Home">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">
            <!-- Offered as a home app; Android asks the user (or follows the TV's own rules) before switching. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also an ordinary TV app, so it can be opened and tried without changing the home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />
        <activity android:name=".AllAppsActivity" android:exported="false" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />
        <activity android:name=".WallpaperActivity" android:exported="false" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />
        <activity android:name=".AppOrderActivity" android:exported="false" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />
    </application>
</manifest>
